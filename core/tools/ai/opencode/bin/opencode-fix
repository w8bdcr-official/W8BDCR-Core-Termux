#!/data/data/com.termux/files/usr/bin/bash
# opencode-fix — repair a broken OpenCode (proot) install: stop the server,
# reinstall the pinned v1.19.5 binary inside Ubuntu, restart the server.
# Usage: opencode-fix

set -e

OPENCODE_SERVE_URL="http://127.0.0.1:4096"

echo "Stopping any running OpenCode server ..."
pkill -f "opencode serve" 2>/dev/null || true
sleep 1

echo "Reinstalling OpenCode v1.19.5 (pinned) inside Ubuntu ..."
proot-distro login --shared-tmp ubuntu -- /bin/bash -c '
  export SHELL=/bin/bash
  export TMPDIR=/tmp
  export HOME=/root
  set -e
  case "$(uname -m)" in
    aarch64|arm64) _arch="arm64" ;;
    x86_64|amd64) _arch="x64" ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  rm -rf /root/.opencode/bin
  mkdir -p /root/.opencode/bin
  cd /root/.opencode/bin
  curl -fL --retry 3 --retry-delay 2 "https://github.com/anomalyco/opencode/releases/download/v1.19.5/opencode-linux-${_arch}.tar.gz" -o opencode.tar.gz
  tar -zxf opencode.tar.gz
  rm -f opencode.tar.gz
  chmod +x /root/.opencode/bin/opencode
  apt-get update && apt-get install -y curl ca-certificates ripgrep
'

echo "Restarting OpenCode server ..."
proot-distro login --shared-tmp ubuntu -- /bin/bash -c \
  'nohup /root/.opencode/bin/opencode serve --port 4096 --hostname 127.0.0.1 > /root/.opencode/serve.log 2>&1 &'

for _i in $(seq 1 15); do
  if curl -s -m 2 -o /dev/null "$OPENCODE_SERVE_URL/" 2>/dev/null; then
    echo "OpenCode fixed — server is up at $OPENCODE_SERVE_URL"
    echo "Run: opencode-start"
    exit 0
  fi
  sleep 1
done

echo "Server did not come up — see /root/.opencode/serve.log inside Ubuntu" >&2
exit 1
