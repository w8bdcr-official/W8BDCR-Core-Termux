#!/data/data/com.termux/files/usr/bin/bash
# core-start — one small command: check the install, then run Core.
# If the `core` link is broken it is re-created on the spot.
# If the install itself is missing it prints the one command to re-run.
# (Repair a broken install with `core-fix`.)
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
CORE_DATA_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/core-termux"
CORE_CONFIG_DEFAULT="${XDG_CONFIG_HOME:-$HOME/.config}/core-termux"
CORE_DATA="$CORE_DATA_DEFAULT"

if [[ -f "$CORE_CONFIG_DEFAULT/config" ]]; then
  # shellcheck disable=SC1090
  . "$CORE_CONFIG_DEFAULT/config"
  CORE_DATA="${core_data:-$CORE_DATA_DEFAULT}"
fi

if [[ ! -x "$CORE_DATA/core/bin/core" ]]; then
  echo "Core is not installed here ($CORE_DATA/core/bin/core is missing)."
  echo "Run core-fix to repair it, or re-run the installer:"
  echo '  curl -fsSL "https://raw.githubusercontent.com/w8bdcr-official/W8BDCR-Core-Termux/main/install.sh?$(date +%s)" | bash'
  exit 1
fi

if [[ ! -L "$PREFIX/bin/core" ]] || [[ ! -e "$PREFIX/bin/core" ]]; then
  ln -sf "$CORE_DATA/core/bin/core" "$PREFIX/bin/core"
fi

exec "$PREFIX/bin/core" "$@"
